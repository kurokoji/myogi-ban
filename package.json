{
  "name": "myogi-ban",
  "version": "1.0.0",
  "description": "Fighting game controller viewer for OBS",
  "main": "dist/electron.js",
  "scripts": {
    "build": "npm run build:server && npm run build:electron && npm run build:editor && npm run build:viewer",
    "build:server": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js --external:ws --external:express",
    "build:electron": "esbuild src/electron.ts --bundle --platform=node --outfile=dist/electron.js --external:electron --external:ws --external:express",
    "build:editor": "esbuild src/editor.tsx --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/editor.js",
    "build:viewer": "esbuild src/viewer.tsx --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/viewer.js",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && LD_LIBRARY_PATH=$PWD/.libs/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH electron .",
    "start:web": "npm run build && node dist/server.js",
    "stop": "node -e \"const fs = require('fs'); const path = require('path'); const pidFile = path.join(__dirname, 'server.pid'); if (fs.existsSync(pidFile)) { const pid = fs.readFileSync(pidFile, 'utf8'); try { process.kill(parseInt(pid), 'SIGTERM'); console.log('Server stopped (PID: ' + pid + ')'); } catch (e) { console.log('Server not running'); } if (fs.existsSync(pidFile)) { fs.unlinkSync(pidFile); } } else { console.log('Server not running (no PID file)'); }\"",
    "dev": "npm run build && LD_LIBRARY_PATH=$PWD/.libs/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH electron . --dev"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "express": "^4.18.2",
    "i18next": "^26.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.10",
    "electron": "^43.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "electron@43.0.0": true,
    "esbuild@0.20.2": true
  }
}
